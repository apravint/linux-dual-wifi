#!/usr/bin/env bash
# ==============================================================================
# linux-dual-wifi: Multi-WAN & Dual Wi-Fi ECMP Load Balancer for Linux
# https://github.com/apravint/linux-dual-wifi
# ==============================================================================
# Aggregates two active Wi-Fi adapters (e.g. internal PCIe + external USB)
# using Linux Kernel Equal-Cost Multi-Path (ECMP) policy routing, layer 4
# flow hashing, and ARP flux mitigation.
# ==============================================================================

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Auto-detect wireless interfaces if not provided via env
detect_interfaces() {
    local detected=()
    if command -v nmcli >/dev/null 2>&1; then
        mapfile -t detected < <(nmcli -t -f DEVICE,TYPE dev status 2>/dev/null | grep ':wifi$' | cut -d':' -f1 || true)
    fi

    if [ ${#detected[@]} -lt 2 ]; then
        mapfile -t detected < <(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -E '^wl' || true)
    fi

    echo "${detected[@]}"
}

ALL_IFS=($(detect_interfaces))

IF1="${DUAL_WIFI_IF1:-${ALL_IFS[0]:-}}"
IF2="${DUAL_WIFI_IF2:-${ALL_IFS[1]:-}}"

get_ip() {
    ip -4 addr show dev "$1" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1 || true
}

get_gw() {
    local gw
    gw=$(ip route show dev "$1" default 2>/dev/null | awk '{print $3}' | head -n1 || true)
    if [ -z "$gw" ]; then
        # Check table 200 / 100 or lookup default route via dev
        gw=$(ip route show table 200 dev "$1" default 2>/dev/null | awk '{print $3}' | head -n1 || true)
    fi
    if [ -z "$gw" ]; then
        gw=$(ip route show table 100 dev "$1" default 2>/dev/null | awk '{print $3}' | head -n1 || true)
    fi
    if [ -z "$gw" ]; then
        # Fallback: check dhcp lease or gateway on same subnet
        gw=$(ip route show 2>/dev/null | grep -E "dev $1" | grep -oP '(?<=via )\d+(\.\d+){3}' | head -n1 || true)
    fi
    if [ -z "$gw" ]; then
        # Fallback to default route gateway in main
        gw=$(ip route show default 2>/dev/null | awk '{print $3}' | head -n1 || true)
    fi
    echo "$gw"
}

get_ssid() {
    if command -v nmcli >/dev/null 2>&1; then
        nmcli -t -f DEVICE,CONNECTION dev 2>/dev/null | grep "^$1:" | cut -d':' -f2 | head -n1 || echo "Unknown"
    else
        echo "Unknown"
    fi
}

get_signal() {
    if command -v nmcli >/dev/null 2>&1; then
        nmcli --rescan no -t -f IN-USE,SIGNAL dev wifi list ifname "$1" 2>/dev/null | grep '^\*' | cut -d':' -f2 | head -n1 || echo "N/A"
    else
        echo "N/A"
    fi
}

show_status() {
    echo -e "${BLUE}======================================================${NC}"
    echo -e "${CYAN}📡 Linux Dual Wi-Fi Multi-WAN Status${NC}"
    echo -e "${BLUE}======================================================${NC}"
    
    if [ -z "$IF1" ] || [ -z "$IF2" ]; then
        echo -e "${YELLOW}Warning: Less than two wireless adapters detected.${NC}"
        echo -e "Available wireless interfaces: ${ALL_IFS[*]:-none}"
        echo -e "Set interfaces explicitly with: export DUAL_WIFI_IF1=<if1> DUAL_WIFI_IF2=<if2>"
        return 0
    fi

    IP1=$(get_ip "$IF1")
    GW1=$(get_gw "$IF1")
    SSID1=$(get_ssid "$IF1")
    SIG1=$(get_signal "$IF1")

    IP2=$(get_ip "$IF2")
    GW2=$(get_gw "$IF2")
    SSID2=$(get_ssid "$IF2")
    SIG2=$(get_signal "$IF2")

    echo -e "Primary Adapter: ${GREEN}${IF1}${NC}"
    echo -e "  SSID       : ${YELLOW}${SSID1}${NC} (Signal: ${SIG1}%)"
    echo -e "  IP Address : ${IP1:-Not Connected}"
    echo -e "  Gateway    : ${GW1:-N/A}"
    echo ""
    echo -e "Secondary Adapter: ${GREEN}${IF2}${NC}"
    echo -e "  SSID       : ${YELLOW}${SSID2}${NC} (Signal: ${SIG2}%)"
    echo -e "  IP Address : ${IP2:-Not Connected}"
    echo -e "  Gateway    : ${GW2:-N/A}"
    echo ""
    echo -e "${CYAN}Current Default Routing Table:${NC}"
    ip route show default
    echo -e "${BLUE}======================================================${NC}"
}

enable_balance() {
    if [ -z "$IF1" ] || [ -z "$IF2" ]; then
        echo -e "${RED}❌ Error: Two wireless adapters are required.${NC}"
        echo -e "Available interfaces: ${ALL_IFS[*]:-none}"
        exit 1
    fi

    IP1=$(get_ip "$IF1")
    GW1=$(get_gw "$IF1")
    IP2=$(get_ip "$IF2")
    GW2=$(get_gw "$IF2")

    if [ -z "$IP1" ] || [ -z "$IP2" ]; then
        echo -e "${RED}❌ Error: Both adapters must have an active IPv4 address.${NC}"
        echo -e "${IF1}: IP=${IP1:-None} GW=${GW1:-None}"
        echo -e "${IF2}: IP=${IP2:-None} GW=${GW2:-None}"
        exit 1
    fi

    if [ -z "$GW1" ] || [ -z "$GW2" ]; then
        echo -e "${RED}❌ Error: Unable to determine gateway IP for both adapters.${NC}"
        exit 1
    fi

    echo -e "${CYAN}Configuring Dual Wi-Fi ECMP Balancing across ${IF1} and ${IF2}...${NC}"

    # 1. ARP Flux Prevention
    sudo sysctl -w net.ipv4.conf.all.arp_ignore=1 >/dev/null 2>&1 || true
    sudo sysctl -w net.ipv4.conf.all.arp_announce=2 >/dev/null 2>&1 || true
    sudo sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1 || true

    # 2. Layer 4 Flow Hashing (balances TCP/UDP flows evenly)
    sudo sysctl -w net.ipv4.fib_multipath_hash_policy=1 >/dev/null 2>&1 || true

    # 3. Policy Routing Tables
    sudo ip route replace default via "$GW1" dev "$IF1" table 100 2>/dev/null || sudo ip route add default via "$GW1" dev "$IF1" table 100
    sudo ip route replace default via "$GW2" dev "$IF2" table 200 2>/dev/null || sudo ip route add default via "$GW2" dev "$IF2" table 200

    sudo ip rule del from "$IP1" table 100 2>/dev/null || true
    sudo ip rule add from "$IP1" table 100 2>/dev/null || true

    sudo ip rule del from "$IP2" table 200 2>/dev/null || true
    sudo ip rule add from "$IP2" table 200 2>/dev/null || true

    # 4. Multi-path Equal Cost Route
    sudo ip route replace default scope global \
        nexthop via "$GW1" dev "$IF1" weight 1 \
        nexthop via "$GW2" dev "$IF2" weight 1

    echo -e "${GREEN}✅ Dual Wi-Fi ECMP Multi-Path Balancing Active!${NC}"
    echo -e "Traffic flows are now balanced across ${GREEN}${IF1}${NC} and ${GREEN}${IF2}${NC}."
    echo ""
    ip route show default
}

keepalive() {
    local target_if="${IF2:-${IF1}}"
    echo -e "${CYAN}Dual Wi-Fi Keepalive Daemon active for ${target_if}...${NC}"
    while true; do
        target_ip=$(get_ip "$target_if")
        target_gw=$(get_gw "$target_if")
        if [ -n "$target_ip" ] && [ -n "$target_gw" ]; then
            ping -c 1 -W 2 -I "$target_ip" "$target_gw" >/dev/null 2>&1 || true
            sleep 5
        else
            sleep 15
        fi
    done
}

clean_balance() {
    echo -e "${YELLOW}Restoring single default route...${NC}"
    GW1=$(get_gw "$IF1")
    if [ -n "$GW1" ]; then
        sudo ip route replace default via "$GW1" dev "$IF1" 2>/dev/null || true
    fi
    echo -e "${GREEN}✅ Default routing restored via ${IF1}.${NC}"
}

run_benchmark() {
    echo -e "${BLUE}======================================================${NC}"
    echo -e "${CYAN}⚡ Linux Dual Wi-Fi Multi-WAN Benchmark${NC}"
    echo -e "${BLUE}======================================================${NC}"

    if [ -z "$IF1" ] || [ -z "$IF2" ]; then
        echo -e "${RED}❌ Error: Two wireless adapters are required for benchmark.${NC}"
        echo -e "Available interfaces: ${ALL_IFS[*]:-none}"
        exit 1
    fi

    IP1=$(get_ip "$IF1")
    IP2=$(get_ip "$IF2")

    if [ -z "$IP1" ] || [ -z "$IP2" ]; then
        echo -e "${RED}❌ Error: Both adapters must have active IPv4 addresses.${NC}"
        echo -e "${IF1}: IP=${IP1:-None}"
        echo -e "${IF2}: IP=${IP2:-None}"
        exit 1
    fi

    echo -e "Testing latency to 1.1.1.1 via ${GREEN}${IF1}${NC} ($IP1) and ${GREEN}${IF2}${NC} ($IP2)..."
    RTT1=$(ping -c 2 -W 2 -I "$IP1" 1.1.1.1 2>/dev/null | grep 'rtt' | awk -F '/' '{print $5}' || echo "N/A")
    RTT2=$(ping -c 2 -W 2 -I "$IP2" 1.1.1.1 2>/dev/null | grep 'rtt' | awk -F '/' '{print $5}' || echo "N/A")

    echo -e "  ${IF1} Latency: ${YELLOW}${RTT1:-N/A} ms${NC}"
    echo -e "  ${IF2} Latency: ${YELLOW}${RTT2:-N/A} ms${NC}"
    echo ""
    echo -e "Firing concurrent multi-stream download test..."

    TEST_URL="https://speed.cloudflare.com/__down?bytes=5000000"
    tmp1=$(mktemp)
    tmp2=$(mktemp)

    curl -s --interface "$IP1" -o /dev/null -w "%{speed_download}" --max-time 5 "$TEST_URL" > "$tmp1" 2>/dev/null &
    pid1=$!
    curl -s --interface "$IP2" -o /dev/null -w "%{speed_download}" --max-time 5 "$TEST_URL" > "$tmp2" 2>/dev/null &
    pid2=$!

    wait "$pid1" "$pid2" 2>/dev/null || true

    s1=$(cat "$tmp1" 2>/dev/null | tr -d '\n\r ' || echo "0")
    s2=$(cat "$tmp2" 2>/dev/null | tr -d '\n\r ' || echo "0")
    rm -f "$tmp1" "$tmp2"

    python3 -c "
s1 = float('$s1' or 0)
s2 = float('$s2' or 0)
m1 = (s1 * 8) / 1000000
m2 = (s2 * 8) / 1000000
comb = m1 + m2
print('=' * 54)
print(f'Primary Adapter   ($IF1):   {m1:6.2f} Mbps | RTT: $RTT1 ms')
print(f'Secondary Adapter ($IF2):   {m2:6.2f} Mbps | RTT: $RTT2 ms')
print('-' * 54)
print(f'Combined Aggregate Throughput:  {comb:6.2f} Mbps')
print('=' * 54)
"
}

# Parse flags or positional args
while [[ $# -gt 0 ]]; do
    case "$1" in
        -1|--if1)
            IF1="$2"
            shift 2
            ;;
        -2|--if2)
            IF2="$2"
            shift 2
            ;;
        status|balance|benchmark|keepalive|clean)
            ACTION="$1"
            shift
            ;;
        *)
            echo "Unknown argument: $1"
            echo "Usage: dual-wifi [--if1 <interface>] [--if2 <interface>] {status|balance|benchmark|keepalive|clean}"
            exit 1
            ;;
    esac
done

ACTION="${ACTION:-status}"

case "$ACTION" in
    status)
        show_status
        ;;
    balance)
        enable_balance
        ;;
    benchmark)
        run_benchmark
        ;;
    keepalive)
        keepalive
        ;;
    clean)
        clean_balance
        ;;
esac
